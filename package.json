{
	"name": "pdf-anonimo",
	"version": "1.0.0",
	"description": "Herramienta de anonimización de PDFs con cumplimiento RGPD",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"electron:start": "NODE_ENV=development electron .",
		"electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
		"electron:prod": "npm run build && NODE_ENV=production electron .",
		"electron:build": "npm run build && electron-builder"
	},
	"build": {
		"appId": "com.juananruiz.pdf-anonimo",
		"productName": "PDF Anónimo",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"dist/**/*",
			"electron/**/*"
		],
		"mac": {
			"category": "public.app-category.utilities",
			"target": "dmg"
		},
		"win": {
			"target": "nsis"
		},
		"linux": {
			"target": "AppImage"
		}
	},
	"dependencies": {
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^4.10.38",
		"tesseract.js": "^4.1.1"
	},
	"devDependencies": {
		"canvas": "^3.2.3",
		"concurrently": "^9.2.1",
		"electron": "42.2.0",
		"electron-builder": "^26.8.1",
		"jsdom": "^29.1.1",
		"vite": "^8.0.13",
		"vitest": "^4.1.6",
		"wait-on": "^9.0.10"
	}
}
